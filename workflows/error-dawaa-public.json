        "jsCode": "\nconst low = $input.all()\n  .map(i => i.json)\n  .filter(p =>\n    p.sku &&\n    Number(p.stock) <= Number(p.reorder_level)\n  );\n\nif (!low.length) return [];\n\nreturn [{\n  json: {\n    text: '📦 Reorder list (' + low.length + '):\\n' +\n      low.map(p =>\n        '• ' + p.sku +\n        ' | ' + p.name +\n        ' | ' + p.strength +\n        ' - stock ' + p.stock +\n        ' (reorder at ' + p.reorder_level + ')'\n      ).join('\\n')\n  }\n}];\n"
      },
