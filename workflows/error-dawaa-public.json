      "id": "40cc7b1c-8b45-4737-a5c9-45ce92b8715c",
      "name": "Error Trigger"
    },
    {
      "parameters": {
        "jsCode": "\nconst data = $input.first().json;\n\nconst workflow = data.workflow || {};\nconst execution = data.execution || {};\nconst error = execution.error || data.trigger?.error || data.error || {};\n\n// Workflow and error details\nconst workflowName = workflow.name || 'Unknown Workflow';\n\nconst nodeName =\n  execution.lastNodeExecuted ||\n  error.node?.name ||\n  'Unknown Node';\n\nconst message = String(\n  error.message ||\n  error.cause?.message ||\n  'Unknown Error'\n);\n\nconst executionUrl =\n  execution.url ||\n  data.execution_url ||\n  'No execution URL';\n\n// Classify error\nlet type = 'unknown';\nlet severity = 'warning';\n\nconst msg = message.toLowerCase();\n\nif (/401|403|unauthorized|forbidden|credential|token/.test(msg)) {\n  type = 'authentication';\n  severity = 'critical';\n}\nelse if (/timeout|network|econn|502|503|504/.test(msg)) {\n  type = 'network';\n  severity = 'error';\n}\nelse if (/429|rate limit|quota/.test(msg)) {\n  type = 'rate_limit';\n  severity = 'error';\n}\nelse if (/validation|invalid|missing|required/.test(msg)) {\n  type = 'validation';\n  severity = 'warning';\n}\n\n// Egypt date and time\nconst time = new Date().toLocaleString('sv-SE', {\n  timeZone: 'Africa/Cairo',\n  hour12: false\n}).slice(0, 16);\n\n// Alert message\nconst text = [\n  `⚠️ ${workflowName} • ${type}`,\n  `Node: ${nodeName}`,\n  message,\n  executionUrl\n].join('\\n');\n\n// Return output\nreturn [{\n  json: {\n    time,\n    workflow: workflowName,\n    node: nodeName,\n    type,\n    severity,\n    message,\n    execution_url: executionUrl,\n    text\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1792,
        -128
      ],
      "id": "de5cb102-5153-4233-9135-e1efa51a5354",
