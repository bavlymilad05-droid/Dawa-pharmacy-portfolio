      "parameters": {
        "jsCode": "\n // Reservations not picked up within 2 hours expire,\n // and their stock goes back on the shelf.\n\nconst now = $now.setZone('Africa/Cairo').toFormat('yyyy-MM-dd HH:mm');\n\nreturn $('Read Reservations')\n  .all()\n  .map(i => i.json)\n  .filter(r =>\n    r.res_id &&\n    r.expires_at &&\n    r.expires_at < now\n  )\n  .map(r => ({ json: r }));\n"
      },
